            "pages": [
              "answering/how-it-works",
              "answering/knowledge-sources",
              "answering/confidence-and-escalation",
              "answering/playground"
            ]
          },
          {
            "group": "Moderation",
            "pages": [
              "moderation/automod",
              "moderation/scam-defense",
              "moderation/raid-protection",
              "moderation/moderator-commands"
            ]
          },
          {
            "group": "For members",
            "pages": [
              "blacklist/account-blacklisted"
            ]
          },
          {
            "group": "Tickets",
            "pages": [
              "tickets/overview",
              "tickets/setup",
              "tickets/managing-tickets"
            ]
          },
          {
            "group": "Help Center",
            "pages": [
              "help-center/overview",
              "help-center/custom-domain"
            ]
          },
          {
            "group": "Dashboard & Settings",
            "pages": [
              "dashboard/overview",
