{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Thea",
  "theme": "almond",
  "colors": {
    "primary": "#1c2fb8",
    "light": "#93aaf5",
    "dark": "#0a0a0a"
  },
  "logo": {
    "light": "/images/thea-wordmark-light.svg",
    "dark": "/images/thea-wordmark-light.svg",
    "href": "https://www.theabot.com"
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Merriweather"
    },
    "body": {
      "family": "Geist"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "favicon": "https://media.brand.dev/19dde7ca-e688-4c28-b743-0301a8015e57.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "plans-and-billing"]
          },
          {
            "group": "Answering",
            "pages": [
              "answering/how-it-works",
              "answering/knowledge-sources",
              "answering/settings",
              "answering/confidence-and-escalation",
              "answering/playground",
              "answering/conversations"
            ]
          },
          {
            "group": "Moderation",
            "pages": [
              "moderation/automod",
              "moderation/scam-defense",
              "moderation/raid-protection",
              "moderation/global-blacklist",
              "moderation/moderator-commands",
              "moderation/standing"
            ]
          },
          {
            "group": "For members",
            "pages": ["blacklist/account-blacklisted"]
          },
          {
            "group": "Tickets",
            "pages": [
              "tickets/overview",
              "tickets/setup",
              "tickets/managing-tickets"
            ]
          },
          {
            "group": "Community",
            "pages": [
              "community/welcome",
              "dashboard/onboarding-forms",
              "community/announcements",
              "community/saved-replies",
              "community/server-logs"
            ]
          },
          {
            "group": "Help Center",
            "pages": ["help-center/overview", "help-center/custom-domain"]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/overview",
              "dashboard/analytics",
              "dashboard/integrations",
              "dashboard/content-api",
              "dashboard/backup-and-clone",
              "dashboard/collaborators",
              "dashboard/audit",
              "dashboard/discord-setup"
            ]
          },
          {
            "group": "Account",
            "pages": ["account/standing"]
          },
          {
            "group": "Reference",
            "pages": ["reference/actions"]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/reference/slash-commands",
      "destination": "/reference/actions",
      "permanent": true
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "Product",
        "href": "https://www.theabot.com/product"
      },
      {
        "label": "How it works",
        "href": "https://www.theabot.com/product#how-it-works"
      },
      {
        "label": "Pricing",
        "href": "https://www.theabot.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://www.theabot.com/auth/signup"
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.theabot.com"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Pricing", "href": "https://www.theabot.com/pricing" },
          { "label": "Status", "href": "https://www.theabot.com/status" },
          { "label": "Changelog", "href": "https://www.theabot.com/changelog" }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "Privacy", "href": "https://www.theabot.com/privacy" },
          { "label": "Terms", "href": "https://www.theabot.com/terms" },
          { "label": "Acceptable use", "href": "https://www.theabot.com/acceptable-use" }
        ]
      }
    ]
  }
}
