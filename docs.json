{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Thea",
  "theme": "almond",
  "colors": {
    "primary": "#1c2fb8",
    "light": "#93aaf5",
    "dark": "#0a0a0a"
  },
  "logo": {
    "light": "/images/thea-wordmark-light.svg",
    "dark": "/images/thea-wordmark-light.svg",
